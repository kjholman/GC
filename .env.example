# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/genesys_analyst"

# ── Authentication ─────────────────────────────────────────────────────────
# 32+ random characters. Generate with: openssl rand -base64 48
AUTH_SECRET=""
# Only addresses at these domains can ever be allow-listed.
ALLOWED_EMAIL_DOMAINS="genesyscapital.com"
# Seeded on `npm run db:seed` (comma-separated). Admins can add more in-app.
SEED_ADMIN_EMAILS=""
SEED_ANALYST_EMAILS=""
APP_URL="https://analyst.genesyscapital.com"

# ── Email delivery of sign-in codes (Microsoft 365, SendGrid, SES, …) ─────
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Genesys Analyst <analyst@genesyscapital.com>"
# MAIL_TRANSPORT="console"   # local testing only: print codes to the server log

# ── AI analyst (Anthropic Claude) ──────────────────────────────────────────
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5-5"
# low | medium | high | xhigh | max — depth of reasoning per memo
ANALYSIS_EFFORT="high"
# Live web research (literature, trials, competitors, comps) before each memo
ENABLE_WEB_RESEARCH="true"
