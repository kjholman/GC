// Genesys Capital — AI Investment Analyst
// Data model for deal flow, AI analyses, and the firm's portfolio knowledge base.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity & access ──────────────────────────────────────────────────────

enum Role {
  ANALYST
  PARTNER
  ADMIN
}

/// A user exists only if an administrator has allow-listed their email.
/// There are no passwords: sign-in is a one-time code sent to this address.
model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  title       String?
  role        Role      @default(ANALYST)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  sessions      Session[]
  feedback      AnalysisFeedback[]
  dealsOwned    Deal[]       @relation("DealOwner")
  documents     Document[]
  analyses      Analysis[]
  activities    Activity[]
  auditEntries  AuditLog[]
}

model LoginCode {
  id         String    @id @default(cuid())
  email      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  ip         String?
  createdAt  DateTime  @default(now())

  @@index([email, createdAt])
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Deal flow ──────────────────────────────────────────────────────────────

enum DealStatus {
  SCREENING     // uploaded, first analysis running
  PENDING_INFO  // worth pursuing, but we need more from the founders
  DILIGENCE     // passed screening — formal due diligence
  IC_REVIEW     // with Investment Committee
  INVESTED
  REJECTED
  ARCHIVED
}

model Deal {
  id            String     @id @default(cuid())
  companyName   String
  oneLiner      String?
  sector        String?
  modality      String?
  stage         String?
  location      String?
  website       String?
  roundSize     String?
  contactName   String?
  contactEmail  String?
  source        String?
  status        DealStatus @default(SCREENING)
  /// AI-extracted fingerprint used to retrieve similar historical deals.
  indication    String?
  tags          String[]   @default([])
  latestScore   Int?
  recommendation String?
  ownerId       String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  owner      User?      @relation("DealOwner", fields: [ownerId], references: [id])
  documents  Document[]
  analyses   Analysis[]
  activities Activity[]

  @@index([status])
  @@index([updatedAt])
}

enum DocumentKind {
  PITCH_DECK
  FINANCIAL_MODEL
  SCIENTIFIC_DATA
  IP_DOCUMENTATION
  CLINICAL_REGULATORY
  CORRESPONDENCE
  OTHER
}

model Document {
  id           String       @id @default(cuid())
  dealId       String
  filename     String
  mimeType     String
  sizeBytes    Int
  sha256       String
  kind         DocumentKind @default(OTHER)
  /// Which analysis round introduced this document (1 = original pitch).
  round        Int          @default(1)
  data         Bytes
  /// Text extracted server-side for non-PDF formats (pptx, docx, xlsx, csv, txt).
  extractedText String?
  /// Plain text of PDFs, used only to check quotes in the evidence ledger.
  plainText     String?
  uploadedById String?
  createdAt    DateTime     @default(now())

  deal       Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  @@index([dealId])
}

enum AnalysisStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

enum AnalysisTrigger {
  INITIAL_SCREEN
  NEW_INFORMATION
  RERUN
}

model Analysis {
  id             String          @id @default(cuid())
  dealId         String
  version        Int
  trigger        AnalysisTrigger @default(INITIAL_SCREEN)
  status         AnalysisStatus  @default(QUEUED)
  progress       String?
  /// Context the analyst typed when submitting (e.g. "Founders replied with CMC data").
  analystContext String?
  recommendation String?
  overallScore   Int?
  memo           Json?
  research       String?
  /// Historical deals and exemplar memos the analyst was shown for this version.
  precedents     Json?
  /// Fact-check report: deterministic checks + independent model verification.
  verification       Json?
  verificationStatus String?
  revisions          Int       @default(0)
  signedOffById      String?
  signedOffAt        DateTime?
  signOffNote        String?
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  error          String?
  createdById    String?
  createdAt      DateTime        @default(now())
  startedAt      DateTime?
  completedAt    DateTime?

  deal      Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdBy User? @relation(fields: [createdById], references: [id])
  feedback  AnalysisFeedback[]

  @@unique([dealId, version])
  @@index([status])
}

model Activity {
  id        String   @id @default(cuid())
  dealId    String
  userId    String?
  type      String
  message   String
  createdAt DateTime @default(now())

  deal Deal  @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([dealId, createdAt])
}

// ─── Institutional memory ───────────────────────────────────────────────────

enum PortfolioOutcome {
  ACTIVE
  IPO
  ACQUIRED
  MERGED
  WOUND_DOWN
  UNKNOWN
}

/// Genesys Capital's historical investments. Injected into every analysis so
/// the model benchmarks new opportunities against what the firm has actually
/// backed — and how those bets turned out.
model PortfolioCompany {
  id           String           @id @default(cuid())
  name         String           @unique
  sector       String
  modality     String?
  indication   String?
  description  String
  yearInvested Int?
  stageAtEntry String?
  outcome      PortfolioOutcome @default(UNKNOWN)
  outcomeNotes String?
  lessons      String?
  website      String?
  /// false = imported from public sources and awaiting confirmation by the firm.
  verified     Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

// ─── Analyst calibration ────────────────────────────────────────────────────

enum FeedbackVerdict {
  AGREE
  TOO_OPTIMISTIC
  TOO_PESSIMISTIC
  WRONG_DECISION
}

/// A partner's or analyst's critique of an AI memo. Recent feedback is fed
/// back into every future analysis so the AI analyst converges on the
/// partnership's own judgement.
model AnalysisFeedback {
  id                      String          @id @default(cuid())
  analysisId              String
  userId                  String
  verdict                 FeedbackVerdict
  correctedRecommendation String?
  comment                 String
  createdAt               DateTime        @default(now())

  analysis Analysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([createdAt])
}

/// Standing investment principles written by the partnership ("we do not
/// back single-asset companies without composition-of-matter IP", …).
model InvestmentPrinciple {
  id        String   @id @default(cuid())
  title     String
  body      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Training Studio ────────────────────────────────────────────────────────

enum HistoricalDecision {
  INVESTED
  PASSED_AFTER_DILIGENCE
  PASSED_AT_SCREENING
}

enum IngestStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

/// A deal Genesys evaluated in the past, with the decision it actually made
/// and what happened next. Retrieved as precedent for similar new deals and
/// replayed in backtests.
model HistoricalDeal {
  id                String             @id @default(cuid())
  companyName       String
  decisionYear      Int?
  decision          HistoricalDecision
  decisionRationale String
  outcome           PortfolioOutcome   @default(UNKNOWN)
  outcomeNotes      String?
  sector            String?
  modality          String?
  indication        String?
  stage             String?
  tags              String[]           @default([])
  /// AI-written digest of the original materials (what the founders claimed, key facts).
  digest            String?
  icMemoText        String?
  deckFilename      String?
  deckMimeType      String?
  deckData          Bytes?
  deckExtractedText String?
  ingestStatus      IngestStatus       @default(PENDING)
  ingestError       String?
  createdById       String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  backtestResults BacktestResult[]

  @@index([decision])
}

/// A memo the partners corrected and endorsed as the standard to emulate.
model Exemplar {
  id                String   @id @default(cuid())
  title             String
  sourceAnalysisId  String?
  sector            String?
  modality          String?
  indication        String?
  tags              String[] @default([])
  recommendation    String
  overallScore      Int
  memo              Json
  partnerCommentary String
  active            Boolean  @default(true)
  createdById       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

model PrincipleSuggestion {
  id        String           @id @default(cuid())
  title     String
  body      String
  evidence  String
  status    SuggestionStatus @default(PENDING)
  createdAt DateTime         @default(now())
}

enum BacktestStatus {
  QUEUED
  RUNNING
  COMPLETE
  FAILED
}

model BacktestRun {
  id          String         @id @default(cuid())
  label       String
  status      BacktestStatus @default(QUEUED)
  /// Snapshot of the training state used: principle/exemplar/archive counts, model, effort.
  config      Json
  total       Int            @default(0)
  completed   Int            @default(0)
  metrics     Json?
  error       String?
  createdById String?
  createdAt   DateTime       @default(now())
  completedAt DateTime?

  results BacktestResult[]
}

model BacktestResult {
  id               String   @id @default(cuid())
  runId            String
  historicalDealId String
  expected         String
  aiRecommendation String?
  aiScore          Int?
  agree            Boolean?
  memo             Json?
  error            String?
  createdAt        DateTime @default(now())

  run            BacktestRun    @relation(fields: [runId], references: [id], onDelete: Cascade)
  historicalDeal HistoricalDeal @relation(fields: [historicalDealId], references: [id], onDelete: Cascade)

  @@index([runId])
}

/// Partner-editable firm parameters injected into the analyst's instructions.
model FirmSetting {
  key         String   @id
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
}
